<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView
        android:id="@+id/routeOptionsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/route_options_loading"
        android:textColor="@color/text_primary"
        android:textSize="21sp"
        android:textStyle="bold" />
    <dev.warp.stream.Map3dView
        android:id="@+id/routeOptionsMapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:padding="12dp">
        <TextView
            android:id="@+id/routeOptionsHazards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/route_options_hazards_loading"
            android:textColor="@color/chip_warn"
            android:textSize="13sp"
            android:textStyle="bold" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/routeOptionsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/route_options_loading"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/routeOptionsStartBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/accent"
            android:text="@string/route_options_start"
            android:textAllCaps="false" />
        <Button
            android:id="@+id/routeOptionsCloseBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/bg_surface"
            android:text="@string/route_options_close"
            android:textAllCaps="false" />
        <Button
            android:id="@+id/routeOptionsShareBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/bg_surface"
            android:text="@string/route_options_share_eta"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
